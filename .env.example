# Token bot dari @BotFather
BOT_TOKEN=

# Lokasi file database SQLite
DATABASE_PATH=data/vorsa.sqlite3

# Jarak antar pengecekan RSS (menit)
CHECK_INTERVAL_MINUTES=15

# ID Telegram pemilik yang boleh memakai bot (pisahkan dengan koma).
# Belum tahu ID-mu? Jalankan bot lalu kirim /start — bot akan memberitahu.
OWNER_TELEGRAM_IDS=
